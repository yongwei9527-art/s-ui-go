# Reference unit for a manually installed /usr/local/s-ui instance.
# The packaged install-linux.sh generates the authoritative unit and state.
[Unit]
Description=s-ui-go 0.1 Proxy Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s-ui
Group=s-ui
WorkingDirectory=/usr/local/s-ui
ExecStart=/usr/local/s-ui/sui
Restart=on-failure
RestartSec=10
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/usr/local/s-ui/db /usr/local/s-ui/logs /usr/local/s-ui/cert
Environment=SUI_DB_FOLDER=db
Environment=SUI_DEBUG=false

[Install]
WantedBy=multi-user.target